{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "composite": true,

    /* Node.js globals */
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts"
  ]
}
