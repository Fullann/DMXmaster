{
  "name": "dmxmaster",
  "version": "1.0.0",
  "description": "Professional DMX Lighting Control Desktop Application",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "electron-rebuild -f -w serialport"
  },
  "build": {
    "appId": "com.dmxmaster.app",
    "productName": "DMX Master",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "adm-zip": "^0.5.18",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.31.0",
    "postprocessing": "^6.39.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "lzma-native@8.0.6": true,
    "@serialport/bindings-cpp@12.0.1": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "electron@32.3.3": true
  },
  "overrides": {
    "esbuild": "0.21.5"
  }
}
